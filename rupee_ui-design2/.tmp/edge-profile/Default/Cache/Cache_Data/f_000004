  width: 52px;\n    height: 52px;\n    border-radius: 12px;\n    object-fit: cover;\n    background: #f1f5f9;\n    flex-shrink: 0;\n    border: 2px solid var(--adm-border);\n}\n\n.adm-advisor-name-lg {\n    font-size: 15px;\n    font-weight: 700;\n    color: var(--adm-text);\n    margin-bottom: 2px;\n}\n\n.adm-advisor-role {\n    font-size: 12px;\n    color: var(--adm-text-muted);\n    margin-bottom: 6px;\n}\n\n.adm-advisor-card-footer {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding-top: 12px;\n    border-top: 1px solid var(--adm-border-light);\n    font-size: 12px;\n    color: var(--adm-text-muted);\n}\n\n.adm-advisor-fee {\n    font-weight: 800;\n    color: var(--adm-accent);\n    font-size: 14px;\n}\n\n.adm-tag-row {\n    display: flex;\n    gap: 5px;\n    flex-wrap: wrap;\n    margin-top: 4px;\n}\n\n.adm-tag {\n    font-size: 10px;\n    font-weight: 600;\n    padding: 2px 8px;\n    background: var(--adm-accent-light);\n    border: 1px solid var(--adm-accent-border);\n    border-radius: 100px;\n    color: var(--adm-accent);\n}\n\n.adm-delete-btn {\n    width: 100%;\n    margin-top: 14px;\n    padding: 8px;\n    border: 1px solid #fca5a5;\n    background: #fef2f2;\n    color: var(--adm-danger);\n    border-radius: 8px;\n    font-weight: 600;\n    font-size: 12px;\n    cursor: pointer;\n    font-family: inherit;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 6px;\n    transition: all var(--adm-transition);\n}\n\n.adm-delete-btn:hover {\n    background: var(--adm-danger);\n    color: #fff;\n    border-color: var(--adm-danger);\n}\n\n.adm-delete-btn:disabled {\n    opacity: 0.5;\n    cursor: not-allowed;\n}\n\n.adm-hamburger-btn {\n    display: none;\n    background: transparent;\n    border: none;\n    cursor: pointer;\n    padding: 4px;\n    border-radius: 8px;\n    color: var(--adm-text-muted);\n    transition: background var(--adm-transition);\n}\n\n.adm-hamburger-btn:hover {