l);\n    width: 100%;\n    max-width: 540px;\n    max-height: 92vh;\n    display: flex;\n    flex-direction: column;\n    box-shadow: var(--shadow-modal);\n    overflow: hidden;\n    animation: popIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n\n.up-date-grid {\n    display: grid;\n    grid-template-columns: repeat(7, 1fr);\n    gap: 6px;\n    flex: 1;\n}\n\n.up-date-grid-btn {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    padding: 8px 4px;\n    border-radius: var(--radius-md);\n    border: 1.5px solid var(--border-color);\n    background: var(--bg-surface);\n    cursor: pointer;\n    transition: all var(--transition-fast);\n    gap: 2px;\n}\n\n.up-date-grid-btn:hover:not(:disabled) {\n    border-color: var(--color-primary);\n    background: var(--color-primary-light);\n}\n\n.up-date-grid-btn-active {\n    background: var(--color-primary);\n    border-color: var(--color-primary);\n}\n\n.up-date-grid-btn-active .up-date-grid-day,\n.up-date-grid-btn-active .up-date-grid-date,\n.up-date-grid-btn-active .up-date-grid-month {\n    color: #fff;\n}\n\n.up-date-grid-day {\n    font-size: 9px;\n    font-weight: 700;\n    color: var(--text-muted);\n    text-transform: uppercase;\n}\n\n.up-date-grid-date {\n    font-size: 16px;\n    font-weight: 800;\n    color: var(--text-main);\n    line-height: 1;\n}\n\n.up-date-grid-month {\n    font-size: 9px;\n    font-weight: 600;\n    color: var(--text-light);\n}\n\n.up-today-label {\n    color: var(--color-primary) !important;\n    font-weight: 800 !important;\n}\n\n.up-time-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));\n    gap: 10px;\n    margin-bottom: 20px;\n}\n\n.up-time-btn {\n    padding: 10px 8px;\n    border-radius: var(--radius-md);\n    border: 1.5px solid var(--border-color);\n    text-align: center;\n    font-size: 12px;\n    font-weight: 600;\n    background: var(--bg-surface);\n    cursor: pointer;\n    transition: all var(--transition-fast);\n    position: relative;\n}\n\n.up-time-btn:hover:not(:disabled) {\n    border-color: var(--color-primary);\n    background: var(--color-primary-light);\n}\n\n.up-time-btn-active {\n    background: var(--color-primary);\n    color: #fff;\n    border-color: var(--color-primary);\n}\n\n.up-time-btn-booked {\n    background: #F1F5F9;\n    color: #94A3B8;\n    border-color: #FECACA;\n    cursor: not-allowed;\n    opacity: 1;\n    position: relative;\n    overflow: hidden;\n}\n\n.up-unavailable-label {\n    font-size: 9px;\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: 0.08em;\n    display: block;\n    margin-top: 2px;\n    position: relative;\n    z-index: 1;\n}\n\n.up-meeting-mode-row {\n    display: flex;\n    gap: 8px;\n    margin-bottom: 20px;\n    flex-wrap: wrap;\n}\n\n.up-meeting-btn {\n    flex: 1;\n    min-width: 90px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 6px;\n    padding: 10px 14px;\n    border-radius: var(--radius-md);\n    border: 1.5px solid var(--border-color);\n    background: var(--bg-surface);\n    color: var(--text-muted);\n    font-size: 13px;\n    font-weight: 600;\n    cursor: pointer;\n    transition: all var(--transition-fast);\n}\n\n.up-meeting-btn:hover {\n    border-color: var(--color-primary);\n    color: var(--color-primary);\n}\n\n.up-meeting-btn-active {\n    background: var(--color-primary-light);\n    border-color: var(--color-primary);\n    color: var(--color-primary);\n    font-weight: 700;\n}\n\n.up-notes-textarea {\n    width: 100%;\n    padding: 10px 12px;\n    border: 1.5px solid var(--border-color);\n    border-radius: var(--radius-md);\n    font-size: 13px;\n    resize: vertical;\n    font-family: inherit;\n    outline: none;\n    background: var(--bg-surface);\n    box-sizing: border-box;\n    margin-bottom: 16px;\n    transition: border-color var(--transition-fast);\n}\n\n.up-notes-textarea:focus {\n    border-color: var(--color-primary);\n    box-shadow: 0 0 0 3px var(--color-primary-light);\n}\n\n.up-booking-summary {\n    background: var(--color-primary-light);\n    border: 1px solid var(--color-info-border);\n    border-radius: var(--radius-md);\n    padding: 12px 16px;\n    font-size: 13px;\n    font-weight: 700;\n    color: var(--color-primary);\n    margin-bottom: 16px;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    flex-wrap: wrap;\n}\n\n.up-step-label {\n    font-size: 12px;\n    font-weight: 700;\n    color: var(--text-muted);\n    text-transform: uppercase;\n    letter-spacing: 0.08em;\n    margin-bottom: 12px;\n    margin-top: 4px;\n}\n\n.up-proceed-btn {\n    width: 100%;\n    padding: 14px;\n    border-radius: var(--radius-md);\n    border: none;\n    font-size: 15px;\n    font-weight: 700;\n    cursor: not-allowed;\n    background: var(--border-color);\n    color: var(--text-light);\n    transition: all var(--transition-fast);\n}\n\n.up-proceed-btn-active {\n    background: var(--color-primary-gradient);\n    color: #fff;\n    cursor: pointer;\n    box-shadow: 0 4px 16px rgba(15, 118, 110, 0.3);\n}\n\n.up-proceed-btn-active:hover {\n    filter: brightness(1.08);\n    transform: translateY(-1px);\n}\n\n.up-no-slots-warning {\n    background: var(--color-warning-bg);\n    border: 1.5px solid var(--color-warning-border);\n    border-radius: var(--radius-md);\n    padding: 20px;\n    text-align: center;\n    color: var(--color-warning);\n    font-size: 13px;\n    margin-bottom: 16px;\n}\n\n.up-empty-state {\n    text-align: center;\n    padding: 60px 24px;\n    color: var(--text-muted);\n}\n\n.up-settings-card {\n    background: var(--bg-surface);\n    border-radius: var(--radius-lg);\n    border: 1px solid var(--border-color);\n    overflow: hidden;\n    box-shadow: var(--shadow-sm);\n}\n\n.up-settings-item {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 16px 20px;\n    font-size: 14px;\n    font-weight: 600;\n    color: var(--text-main);\n    border-bottom: 1px solid var(--border-color-light);\n    cursor: pointer;\n    transition: background var(--transition-fast);\n}\n\n.up-settings-item:last-child {\n    border-bottom: none;\n}\n\n.up-settings-item:hover {\n    background: var(--bg-body);\n}\n\n.up-settings-item-danger {\n    color: var(--color-danger);\n}\n\n.up-settings-item-danger:hover {\n    background: var(--color-danger-bg);\n}\n\n.up-bottom-nav {\n    position: fixed;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    height: 64px;\n    background: var(--portal-sidebar-gradient);\n    border-top: 1px solid rgba(255, 255, 255, 0.08);\n    display: flex;\n    justify-content: space-around;\n    align-items: center;\n    z-index: 1000;\n    padding-bottom: env(safe-area-inset-bottom, 0);\n    box-shadow: 0 -10px 28px rgba(22, 52, 95, 0.24);\n}\n\n.up-nav-btn {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 4px;\n    flex: 1;\n    font-size: 11px;\n    font-weight: 700;\n    color: rgba(255, 255, 255, 0.82);\n    border: none;\n    background: none;\n    cursor: pointer;\n    padding: 8px 4px;\n    transition: color var(--transition-fast);\n    text-transform: uppercase;\n    letter-spacing: 0.04em;\n    position: relative;\n}\n\n.up-nav-btn:hover {\n    color: #ffffff;\n}\n\n.up-nav-btn-active {\n    color: #ffffff;\n}\n\n@media (max-width: 600px) {\n    .up-consultant-card {\n        flex-direction: column;\n    }\n\n    .up-card-right {\n        align-items: flex-start;\n        width: 100%;\n        flex-direction: row;\n    }\n\n    .up-tab-padding {\n        padding: 16px 12px 28px;\n    }\n\n    .up-date-grid {\n        grid-template-columns: repeat(7, 1fr);\n        gap: 4px;\n    }\n\n    .up-date-grid-date {\n        font-size: 14px;\n    }\n}\n\n\n/* ─────────────────────────────────────────────────────────────────────────────\n   39. HOME PAGE — MISSING CLASSES (offers, reviews, contact, badges)\n   ───────────────────────────────────────────────────────────────────────────── */\n\n/* ── Section shared ── */\n.hp-section-header {\n    text-align: center;\n    margin-bottom: 48px;\n    padding: 0 24px;\n}\n\n.hp-section-title {\n    font-size: 36px;\n    font-weight: 800;\n    color: #0A1128;\n    margin: 12px 0 8px;\n    font-family: 'Sora', var(--font-family);\n}\n\n.hp-section-subtitle {\n    font-size: 16px;\n    color: var(--text-muted);\n    max-width: 520px;\n    margin: 0 auto;\n    line-height: 1.6;\n}\n\n/* ── Badges ── */\n.hp-badge-primary {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    background: var(--color-primary-light);\n    color: var(--color-primary);\n    border: 1px solid var(--color-info-border);\n    padding: 6px 14px;\n    border-radius: var(--radius-full);\n    font-size: 13px;\n    font-weight: 700;\n}\n\n.hp-badge-success {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    background: var(--color-success-bg);\n    color: var(--color-success);\n    border: 1px solid var(--color-success-border);\n    padding: 6px 14px;\n    border-radius: var(--radius-full);\n    font-size: 13px;\n    font-weight: 700;\n}\n\n/* ── Offers carousel ── */\n.hp-offers-carousel-wrapper {\n    position: relative;\n    overflow: hidden;\n}\n\n.hp-carousel-gradient-left {\n    position: absolute;\n    left: 0;\n    top: 0;\n    bottom: 0;\n    width: 80px;\n    background: linear-gradient(to right, #ECFEFF, transparent);\n    z-index: 2;\n    pointer-events: none;\n}\n\n.hp-carousel-gradient-right {\n    position: absolute;\n    right: 0;\n    top: 0;\n    bottom: 0;\n    width: 80px;\n    background: linear-gradient(to left, #F0FDF4, transparent);\n    z-index: 2;\n    pointer-events: none;\n}\n\n.hp-offers-carousel-track {\n    display: flex;\n    gap: 24px;\n    animation: hpScroll 30s linear infinite;\n    width: max-content;\n    padding: 24px 40px;\n}\n\n.hp-offers-carousel-track:hover {\n    animation-play-state: paused;\n}\n\n@keyframes hpScroll {\n    from {\n        transform: translateX(0);\n    }\n\n    to {\n        transform: translateX(-50%);\n    }\n}\n\n/* ── Offer card internals ── */\n.hp-discount-badge {\n    display: inline-block;\n    background: linear-gradient(135deg, var(--color-primary), #0047CC);\n    color: #fff;\n    font-size: 12px;\n    font-weight: 800;\n    padding: 4px 12px;\n    border-radius: var(--radius-full);\n    margin-bottom: 14px;\n    letter-spacing: 0.5px;\n}\n\n.hp-offer-icon {\n    width: 48px;\n    height: 48px;\n    border-radius: var(--radius-md);\n    background: var(--color-primary-light);\n    color: var(--color-primary);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: 16px;\n}\n\n.hp-offer-title {\n    font-size: 18px;\n    font-weight: 700;\n    color: #0A1128;\n    margin-bottom: 8px;\n    line-height: 1.3;\n}\n\n.hp-offer-desc {\n    font-size: 14px;\n    color: var(--text-muted);\n    line-height: 1.6;\n    margin-bottom: 14px;\n}\n\n.hp-offer-validity {\n    font-size: 12px;\n    color: var(--text-light);\n    font-weight: 500;\n    margin-bottom: 20px;\n}\n\n.hp-offer-btn {\n    width: 100%;\n    padding: 12px;\n    border-radius: var(--radius-md);\n    border: none;\n    background: var(--color-primary-gradient);\n    color: #fff;\n    font-size: 14px;\n    font-weight: 700;\n    cursor: pointer;\n    transition: all var(--transition-fast);\n}\n\n.hp-offer-btn:hover {\n    filter: brightness(1.08);\n    transform: translateY(-1px);\n}\n\n/* ── Reviews ── */\n.hp-reviews-section {\n    padding: 100px 40px;\n    background: var(--bg-body);\n}\n\n.hp-reviews-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\n    gap: 24px;\n}\n\n.hp-review-card {\n    background: var(--bg-surface);\n    border-radius: var(--radius-lg);\n    padding: 28px;\n    border: 1px solid var(--border-color);\n    box-shadow: var(--shadow-sm);\n    transition: all var(--transition-normal);\n    display: flex;\n    flex-direction: column;\n    gap: 14px;\n}\n\n.hp-review-card:hover {\n    transform: translateY(-3px);\n    box-shadow: var(--shadow-md);\n}\n\n.hp-review-text {\n    font-size: 15px;\n    color: var(--text-muted);\n    line-height: 1.7;\n    font-style: italic;\n    flex: 1;\n}\n\n.hp-review-author {\n    border-top: 1px solid var(--border-color-light);\n    padding-top: 14px;\n}\n\n.hp-review-author-name {\n    font-size: 14px;\n    font-weight: 700;\n    color: var(--text-main);\n}\n\n.hp-review-consultant {\n    font-size: 12px;\n    color: var(--text-light);\n    margin-top: 2px;\n}\n\n/* ── Loading ── */\n.hp-loading-container {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    gap: 16px;\n    padding: 60px 20px;\n    color: var(--text-muted);\n    font-size: 14px;\n}\n\n.hp-loading-spinner {\n    width: 36px;\n    height: 36px;\n    border: 3px solid var(--border-color);\n    border-top-color: var(--color-primary);\n    border-radius: 50%;\n    animation: spin 0.7s linear infinite;\n}\n\n/* ── Contact modal ── */\n.hp-contact-modal-overlay {\n    position: fixed;\n    inset: 0;\n    background: rgba(10, 17, 40, 0.75);\n    backdrop-filter: blur(8px);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    z-index: 5000;\n    padding: 16px;\n    animation: fadeIn 0.2s ease forwards;\n}\n\n.hp-contact-modal-content {\n    width: 100%;\n    max-width: 420px;\n    border-radius: var(--radius-xl);\n    overflow: hidden;\n    box-shadow: 0 40px 80px rgba(0, 0, 0, 0.5);\n    animation: popIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n\n.hp-contact-modal-header {\n    background: var(--portal-profile-gradient);\n    padding: 20px 24px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n}\n\n.hp-contact-modal-body {\n    background: #1E293B;\n    padding: 24px;\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n}\n\n.hp-contact-input-wrapper {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    background: rgba(255, 255, 255, 0.06);\n    border: 1px solid rgba(255, 255, 255, 0.12);\n    border-radius: var(--radius-md);\n    padding: 0 14px;\n    transition: border-color 0.2s;\n}\n\n.hp-contact-input-wrapper:focus-within {\n    border-color: rgba(99, 165, 255, 0.5);\n}\n\n.hp-contact-input {\n    flex: 1;\n    background: transparent;\n    border: none;\n    outline: none;\n    padding: 13px 0;\n    font-size: 14px;\n    font-family: inherit;\n    color: #fff;\n}\n\n.hp-contact-input::placeholder {\n    color: rgba(255, 255, 255, 0.35);\n}\n\n.hp-contact-textarea-wrapper {\n    display: flex;\n    align-items: flex-start;\n    gap: 10px;\n    background: rgba(255, 255, 255, 0.06);\n    border: 1px solid rgba(255, 255, 255, 0.12);\n    border-radius: var(--radius-md);\n    padding: 13px 14px;\n    transition: border-color 0.2s;\n}\n\n.hp-contact-textarea-wrapper:focus-within {\n    border-color: rgba(99, 165, 255, 0.5);\n}\n\n.hp-contact-textarea {\n    flex: 1;\n    background: transparent;\n    border: none;\n    outline: none;\n    font-size: 14px;\n    font-family: inherit;\n    color: #fff;\n    resize: none;\n    line-height: 1.6;\n}\n\n.hp-contact-textarea::placeholder {\n    color: rgba(255, 255, 255, 0.35);\n}\n\n.hp-contact-submit-btn {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    width: 100%;\n    padding: 14px;\n    border-radius: var(--radius-md);\n    border: none;\n    background: var(--color-primary);\n    color: #fff;\n    font-size: 14px;\n    font-weight: 700;\n    cursor: pointer;\n    transition: all var(--transition-fast);\n    margin-top: 4px;\n    font-family: inherit;\n}\n\n.hp-contact-submit-btn:hover:not(:disabled) {\n    filter: brightness(1.1);\n    transform: translateY(-1px);\n}\n\n.hp-contact-submit-btn:disabled {\n    opacity: 0.6;\n    cursor: not-allowed;\n}\n\n.hp-contact-success {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n    padding: 16px 0 8px;\n    gap: 8px;\n}\n\n/* ── WhatsApp button ── */\n.hp-whatsapp-button {\n    position: fixed;\n    bottom: 28px;\n    right: 24px;\n    width: 58px;\n    height: 58px;\n    border-radius: 50%;\n    background: #25D366;\n    box-shadow: 0 4px 20px rgba(37, 211, 102, 0.45);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    z-index: 999;\n    transition: all var(--transition-fast);\n    text-decoration: none;\n}\n\n.hp-whatsapp-button:hover {\n    transform: scale(1.1);\n    box-shadow: 0 6px 28px rgba(37, 211, 102, 0.6);\n}\n\n/* ── Animations ── */\n@keyframes popIn {\n    from {\n        opacity: 0;\n        transform: scale(0.95) translateY(16px);\n    }\n\n    to {\n        opacity: 1;\n        transform: scale(1) translateY(0);\n    }\n}\n\n@keyframes fadeIn {\n    from {\n        opacity: 0;\n    }\n\n    to {\n        opacity: 1;\n    }\n}\n\n/* ============================================================\n   ADMIN MODERN OVERRIDES\n   ============================================================ */\n\n:root {\n    --adm-sidebar-w: 256px;\n    --adm-radius: 12px;\n    --adm-radius-sm: 8px;\n    --adm-radius-lg: 16px;\n    --adm-transition: 180ms cubic-bezier(0.4, 0, 0.2, 1);\n    --adm-shadow-card: 0 1px 3px rgba(0, 0, 0, 0.06), 0 1px 2px rgba(0, 0, 0, 0.04);\n    --adm-shadow-elevated: 0 4px 16px rgba(0, 0, 0, 0.08), 0 1px 4px rgba(0, 0, 0, 0.04);\n    --adm-sidebar-bg: var(--portal-sidebar-gradient);\n    --adm-sidebar-border: rgba(255, 255, 255, 0.1);\n    --adm-sidebar-text: rgba(255, 255, 255, 0.88);\n    --adm-sidebar-text-active: #ffffff;\n    --adm-sidebar-active-bg: linear-gradient(135deg, rgba(15, 118, 110, 0.96) 0%, rgba(15, 118, 110, 1) 100%);\n    --adm-sidebar-active-border: rgba(165, 243, 252, 0.48);\n    --adm-sidebar-hover-bg: rgba(255, 255, 255, 0.12);\n    --adm-acc